From: czyt <czytcn@gmail.com>
Subject: Add sync config check before sync guide

This patch adds a check to show message if sync is not enabled.

diff --git a/app/src/sync/syncGuide.ts b/app/src/sync/syncGuide.ts
index baa991e..0e54f1f 100644
--- a/app/src/sync/syncGuide.ts
+++ b/app/src/sync/syncGuide.ts
@@ -233,6 +233,10 @@ export const syncGuide = (app?: App) => {
     if (app && document.querySelector("#barSync")?.classList.contains("toolbar__item--active")) {
         return;
     }
+    if (!window.siyuan.config.sync.enabled) {
+        showMessage(`${window.siyuan.languages.cloudConfigTip}`);
+        return;
+    }
     if (window.siyuan.config.sync.provider === 0 && needSubscribe()) {
         openSyncSetting(app);
         showMessage(window.siyuan.languages._kernel[29].replaceAll("${accountServer}", getCloudURL("")));
