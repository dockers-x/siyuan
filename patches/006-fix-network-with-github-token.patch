From: czyt <czytcn@gmail.com>
Subject: Add GitHub token auth for onnxruntime download

This patch adds GitHub token authentication to fix network issues
when downloading onnxruntime source in GitHub Actions.

diff --git a/Dockerfile b/Dockerfile
index 294b683cb7..xxxxxxxxxx 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -58,6 +58,7 @@ FROM --platform=$BUILDPLATFORM ${ALPINE_IMAGE} AS onnx-source
 ARG ONNX_COMMIT=3a728b75062256951b6e19ce718907cf1a1d4cf0
 ARG ONNX_VERSION
+ARG GITHUB_TOKEN
 RUN apk add --no-cache git
 # 固定提交的源码在构建机上下载一次，网络中断时重试；子模块保持各自锁定的提交。
 RUN <<EORUN
@@ -77,6 +78,10 @@ retry() {
 git config http.version HTTP/1.1
 git config remote.origin.promisor true
 git config remote.origin.partialclonefilter blob:none
+# 使用 GitHub Token 认证解决网络问题
+if [ -n "${GITHUB_TOKEN}" ]; then
+    git config remote.origin.url "https://${GITHUB_TOKEN}@github.com/microsoft/onnxruntime"
+fi
 # 运行库不构建单元测试，避免下载体积较大的测试模型；编译源码和许可文件保持完整。
 git sparse-checkout init --no-cone
 git sparse-checkout set --no-cone '/*' '!/onnxruntime/test/testdata/' '!/winml/test/'
